# Builds the downloadable archive for the current OS.
# cmake -DLK_SOURCE_DIR=.. -DLK_BIN_DIR=.. -DLK_DIST_DIR=.. -DLK_VERSION=.. -P tools/package.cmake
cmake_minimum_required(VERSION 3.24)

foreach(v LK_SOURCE_DIR LK_BIN_DIR LK_DIST_DIR LK_VERSION)
    if(NOT DEFINED ${v})
        message(FATAL_ERROR "${v} is required")
    endif()
endforeach()

file(MAKE_DIRECTORY "${LK_DIST_DIR}")

macro(copy_common dest)
    file(COPY "${LK_SOURCE_DIR}/assets" DESTINATION "${dest}")
    file(COPY "${LK_SOURCE_DIR}/data" DESTINATION "${dest}")
endmacro()

macro(copy_docs dest)
    file(COPY "${LK_SOURCE_DIR}/CREDITS.md" DESTINATION "${dest}")
    file(COPY "${LK_SOURCE_DIR}/packaging/README.txt" DESTINATION "${dest}")
endmacro()

if(CMAKE_HOST_WIN32)
    set(name "LanternKnight-${LK_VERSION}-windows-x64")
    set(stage "${LK_DIST_DIR}/${name}")
    file(REMOVE_RECURSE "${stage}")
    file(MAKE_DIRECTORY "${stage}")
    file(COPY "${LK_BIN_DIR}/LanternKnight.exe" DESTINATION "${stage}")
    copy_common("${stage}")
    copy_docs("${stage}")
    file(REMOVE "${LK_DIST_DIR}/${name}.zip")
    execute_process(COMMAND ${CMAKE_COMMAND} -E tar cf "${LK_DIST_DIR}/${name}.zip" --format=zip "${name}"
                    WORKING_DIRECTORY "${LK_DIST_DIR}" RESULT_VARIABLE rc)
    set(archive "${LK_DIST_DIR}/${name}.zip")
elseif(CMAKE_HOST_APPLE)
    set(name "LanternKnight-${LK_VERSION}-macos-universal")
    set(stage "${LK_DIST_DIR}/${name}")
    set(app "${stage}/Lantern Knight.app")
    file(REMOVE_RECURSE "${stage}")
    file(MAKE_DIRECTORY "${stage}")
    execute_process(COMMAND cp -R "${LK_BIN_DIR}/LanternKnight.app" "${app}" RESULT_VARIABLE rc)
    copy_common("${app}/Contents/Resources")
    copy_docs("${stage}")
    # Ad-hoc signature by default; CI re-signs with a Developer ID when secrets are configured.
    if(NOT DEFINED ENV{LK_SKIP_ADHOC_SIGN})
        execute_process(COMMAND codesign --force --deep --sign - "${app}" RESULT_VARIABLE rc)
        if(NOT rc EQUAL 0)
            message(FATAL_ERROR "codesign failed")
        endif()
    endif()
    file(REMOVE "${LK_DIST_DIR}/${name}.zip")
    execute_process(COMMAND ditto -c -k --sequesterRsrc --keepParent "${name}" "${name}.zip"
                    WORKING_DIRECTORY "${LK_DIST_DIR}" RESULT_VARIABLE rc)
    set(archive "${LK_DIST_DIR}/${name}.zip")
else()
    set(name "LanternKnight-${LK_VERSION}-linux-x64")
    set(stage "${LK_DIST_DIR}/${name}")
    file(REMOVE_RECURSE "${stage}")
    file(MAKE_DIRECTORY "${stage}")
    file(COPY "${LK_BIN_DIR}/LanternKnight" DESTINATION "${stage}"
         FILE_PERMISSIONS OWNER_READ OWNER_WRITE OWNER_EXECUTE GROUP_READ GROUP_EXECUTE WORLD_READ WORLD_EXECUTE)
    copy_common("${stage}")
    copy_docs("${stage}")
    file(COPY "${LK_SOURCE_DIR}/packaging/linux/lantern-knight.desktop" DESTINATION "${stage}")
    file(COPY "${LK_SOURCE_DIR}/packaging/linux/lantern-knight.png" DESTINATION "${stage}")
    file(REMOVE "${LK_DIST_DIR}/${name}.tar.gz")
    execute_process(COMMAND ${CMAKE_COMMAND} -E tar czf "${name}.tar.gz" "${name}"
                    WORKING_DIRECTORY "${LK_DIST_DIR}" RESULT_VARIABLE rc)
    set(archive "${LK_DIST_DIR}/${name}.tar.gz")
endif()

if(NOT rc EQUAL 0)
    message(FATAL_ERROR "Packaging failed (${rc})")
endif()
message(STATUS "Wrote ${archive}")
file(WRITE "${LK_DIST_DIR}/archive_path.txt" "${archive}")
